# 앱이 띄울 웹 주소. 값을 비우면 운영(https://sicksick.kr)을 본다.
#
# 로컬 웹을 보려면:
#   1) cp .env.example .env
#   2) 맥의 LAN IP 를 확인한다 — ipconfig getifaddr en0
#   3) 아래에 그 IP 를 적는다
#   4) APP_VARIANT=development npx expo start
#
# localhost 는 쓸 수 없다. 앱에서의 localhost 는 폰 자신이라 맥에 닿지 않는다.
# 폰과 맥이 같은 와이파이에 있어야 한다.
EXPO_PUBLIC_WEB_URL=

# 개발 빌드로 실행할 때 켠다. 평문 HTTP 접속 예외(iOS ATS / Android cleartext)가
# 이 값에 따라 붙는다. 운영 빌드에는 절대 넣지 않는다.
APP_VARIANT=
