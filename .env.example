# 환경변수 목록. 값은 비워 두고 형식만 남긴다 — 이 파일은 git 에 커밋된다.
#
# 쓰는 곳이 두 군데다.
#
#   1) 로컬에서 실키로 소셜 로그인을 확인할 때
#        cp .env.example .env.local  → 값 채우고 →
#        set -a && source .env.local && set +a && cd be && ./gradlew bootRun
#
#   2) 운영 서버 배포
#        서버의 /etc/sicksick/.env 로 옮겨 적고 chmod 600 →
#        docker compose -f compose.prod.yaml --env-file /etc/sicksick/.env up -d
#
# 값에 따옴표를 붙이지 않는다. docker compose 는 따옴표까지 값으로 읽는다.
# 값에 $ 가 들어가면 $$ 로 이스케이프한다.

# ── DB ──
# 로컬은 비워두면 application.properties 의 기본값(도커 MySQL)을 쓴다.
# 운영은 HeatWave 사설 IP. sslMode=REQUIRED 가 반드시 들어가야 한다.
DB_URL=
DB_USER=
DB_PASSWORD=

# ── 인증 ──
# 32바이트 이상. `openssl rand -base64 48` 로 만든다.
# 이 값이 바뀌면 발급된 액세스 토큰이 전부 무효가 되므로 한 번 정하면 바꾸지 않는다.
JWT_SECRET=

# 운영은 항상 HTTPS 이므로 true. 로컬은 비워둔다
# (Safari 가 http://localhost 에서 Secure 쿠키를 거부한다).
COOKIE_SECURE=

# ── 소셜 로그인 ──
# 브라우저가 보는 우리 서비스 주소. redirect_uri 를 이 값으로 조립하므로
# 각 사 콘솔에 등록한 값과 문자 단위로 같아야 한다.
#   로컬: http://localhost:5173
#   운영: https://<운영도메인>
OAUTH_BASE_URL=

# 실키로 확인할 때는 false 로 둔다. 비워두면 개발용 스텁이 켜진다.
# 운영에서는 compose.prod.yaml 이 false 로 고정하므로 여기에 넣지 않는다.
OAUTH_STUB=

# 카카오: 앱 설정 → 앱 키 → REST API 키 (JavaScript 키가 아니다)
# 시크릿은 보안 탭에서 활성화했을 때만 필요하다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버: 애플리케이션 → 개요. 시크릿은 필수다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
